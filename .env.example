# Django
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC
SECURE_PROXY_SSL_HEADER_ENABLED=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database
# For local quick start keep sqlite:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL, override with:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=brain_db
# DB_USER=postgres_user
# DB_PASSWORD=postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# Email / Auth
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://127.0.0.1:3000

# Heart integration
# Leave HEART_EXECUTE_URL empty to use local/internal Heart service.
HEART_EXECUTE_URL=
HEART_INTERNAL_TOKEN=
HEART_REQUEST_TIMEOUT_SECONDS=15
